{
  "description": "Warms the review raven binary cache so the first review of a session does not wait for a download.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/prefetch.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/prefetch.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
